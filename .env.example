# ─────────────────────────────────────────────────────────────────────────────
# Shared infrastructure (the only thing both projects have in common)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Public base URL of this API (used to build OAuth callback URLs)
APP_URL=https://api.example.com
PORT=3000

# CORS — comma-separated list of allowed browser origins (mobile apps don't need this)
FRONTEND_URL=https://your-frontend-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Tasteep (mobile spirit-tasting journal) — routes /auth/*, /tasteep/*
# ─────────────────────────────────────────────────────────────────────────────
TASTEEP_JWT_SECRET=change_me_tasteep
# Bearer token lifetime (sessions are revocable server-side regardless). Default 365d.
TASTEEP_JWT_EXPIRES_IN=365d

# Email OTP login — SMTP credentials. Leave TASTEEP_SMTP_HOST empty in dev: the
# code is then printed in the server log instead of being emailed.
TASTEEP_SMTP_HOST=
TASTEEP_SMTP_PORT=587
TASTEEP_SMTP_SECURE=false
TASTEEP_SMTP_USER=
TASTEEP_SMTP_PASS=
TASTEEP_SMTP_FROM="Tasteep <no-reply@example.com>"
TASTEEP_OTP_TTL_MINUTES=10
TASTEEP_OTP_MAX_ATTEMPTS=5
TASTEEP_OTP_RESEND_COOLDOWN_SECONDS=60

# Google Sign-In — comma-separated OAuth client IDs whose ID tokens are accepted
# (the iOS, Android and web client IDs of the same Google Cloud project).
TASTEEP_GOOGLE_CLIENT_IDS=

# Discord OAuth (a *separate* Discord application from the SMWS one)
TASTEEP_DISCORD_CLIENT_ID=
TASTEEP_DISCORD_CLIENT_SECRET=
# Redirect URI registered on that Discord app and handled by the mobile app
TASTEEP_DISCORD_REDIRECT_URI=tasteep://auth/discord

# Nominatim geocoding. Their policy requires an identifying User-Agent with a
# contact address. Geocoding returns 503 until this is set.
TASTEEP_NOMINATIM_USER_AGENT="Tasteep/1.0 (you@example.com)"
TASTEEP_NOMINATIM_URL=https://nominatim.openstreetmap.org

# ─────────────────────────────────────────────────────────────────────────────
# SMWS Watchtower (scraper + public inventory feed) — routes /smws/*
# ─────────────────────────────────────────────────────────────────────────────
# Optional. Enables the manual triggers GET /smws/scraper/run-live and
# /run-archive (send it as `x-api-key`). Unset → only the cron schedule runs.
SMWS_SCRAPER_API_KEY=

# Legacy fallback still honoured if TASTEEP_JWT_SECRET is unset: JWT_SECRET
