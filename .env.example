# ─────────────────────────────────────────────────────────────────────────────
# Shared infrastructure (the only thing both projects have in common)
# Deployed environments (dev / preprod / prod) set these as Coolify runtime
# variables, each with its own database and secrets. Locally, point POSTGRES_*
# at a throw-away database: outside NODE_ENV=production, TypeORM synchronize
# alters whatever database this file names.
# ─────────────────────────────────────────────────────────────────────────────
# development locally and on dev; production on preprod and prod (synchronize off).
# The Docker image defaults to production.
NODE_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Public origin of this API, no trailing slash. Prefixed to signed photo URLs.
# https://api.dev.tasteep.eu / https://api.preprod.tasteep.eu / https://api.tasteep.eu
APP_URL=http://localhost:3000
PORT=3000

# CORS — comma-separated list of allowed browser origins (mobile apps don't need this).
# Exact origins (https, no trailing slash), or the browser's preflight fails, e.g.
# https://app.tasteep.eu,https://admin.tasteep.eu
FRONTEND_URL=https://your-frontend-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Tasteep (mobile spirit-tasting journal) — routes /auth/*, /tasteep/*
# ─────────────────────────────────────────────────────────────────────────────
# Required (canonical name). Unique per environment. Startup fails if neither
# this nor the legacy JWT_SECRET is set.
TASTEEP_JWT_SECRET=change_me_tasteep
# Bearer token lifetime (sessions are revocable server-side regardless). Default 365d.
TASTEEP_JWT_EXPIRES_IN=365d

# Email OTP login — SMTP credentials. Leave TASTEEP_SMTP_HOST empty in dev: the
# code is then printed in the server log instead of being emailed. Once the host
# is set, USER and PASS are required (startup fails otherwise).
TASTEEP_SMTP_HOST=
TASTEEP_SMTP_PORT=587
TASTEEP_SMTP_SECURE=false
TASTEEP_SMTP_USER=
TASTEEP_SMTP_PASS=
TASTEEP_SMTP_FROM="Tasteep <no-reply@example.com>"
TASTEEP_OTP_TTL_MINUTES=10
TASTEEP_OTP_MAX_ATTEMPTS=5
TASTEEP_OTP_RESEND_COOLDOWN_SECONDS=60

# Google Sign-In — comma-separated OAuth client IDs whose ID tokens are accepted
# (the iOS, Android and web client IDs of the same Google Cloud project).
TASTEEP_GOOGLE_CLIENT_IDS=

# Discord OAuth (a *separate* Discord application from the SMWS one)
TASTEEP_DISCORD_CLIENT_ID=
TASTEEP_DISCORD_CLIENT_SECRET=
# Redirect URI registered on that Discord app and handled by the mobile app
TASTEEP_DISCORD_REDIRECT_URI=tasteep://auth/discord

# Nominatim geocoding. Their policy requires an identifying User-Agent with a
# contact address. Geocoding returns 503 until this is set.
TASTEEP_NOMINATIM_USER_AGENT="Tasteep/1.0 (you@example.com)"
TASTEEP_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Nightly smws.eu scrape into tasteep_smws_catalog (midnight). Only prod scrapes;
# dev, preprod and workstations set false (their catalog comes from a database
# copy). Manual runs from POST /admin/smws/scraper/run work either way.
TASTEEP_SMWS_SCRAPER_ENABLED=false
# Gap between two requests to smws.eu, in ms (min 500).
TASTEEP_SMWS_REQUEST_INTERVAL_MS=3000
# Optional User-Agent for smws.eu requests.
# TASTEEP_SMWS_USER_AGENT=

# Tasting photos. Processed WebP files are written here; in Docker, mount a
# persistent volume at this path or every redeploy loses them. Back it up.
TASTEEP_PHOTOS_DIR=./data/photos
# Key for signing photo URLs (default: derived from TASTEEP_JWT_SECRET). Set a
# unique one per environment. Changing it, or the JWT secret, invalidates photo
# URLs already handed out.
# TASTEEP_PHOTO_URL_SECRET=

# User feedback (POST /tasteep/feedback): messages one user may send per rolling hour.
TASTEEP_FEEDBACK_MAX_PER_HOUR=5

# Legacy fallback still honoured if TASTEEP_JWT_SECRET is unset or empty: JWT_SECRET

# ─────────────────────────────────────────────────────────────────────────────
# Admin dashboard API — routes /admin/*
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated emails allowed to use /admin/*. They sign in through the normal
# Tasteep login (Google / email OTP). Empty or unset → nobody is an admin.
ADMIN_EMAILS=
# Admin routes reject sessions created more than this many hours ago (default 12).
ADMIN_SESSION_MAX_HOURS=12
# Per-route request limit per minute on /admin/* (default 60).
ADMIN_RATE_LIMIT_PER_MINUTE=60
